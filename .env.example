# === Backend principal: Firebase (recomendado; Supabase pausado no funciona) ===
VITE_DATA_BACKEND=firebase

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_USE_EMULATORS=false

FIREBASE_PROJECT_ID=
ADMIN_ACCESS_CODE=

# Mercado Pago Checkout Pro. Solo servidor. Nunca uses el prefijo VITE_.
# Panel: Tus integraciones > elpuntostreet > Credenciales de prueba o de producción.
# El Access Token de prueba y el de producción son distintos. No uses el número de aplicación como token.
MERCADOPAGO_ACCESS_TOKEN=
# Secreto de firma del webhook. Panel > Webhooks, al guardar la URL. Sin este valor el servidor rechaza notificaciones.
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública https de la tienda, sin barra final. Local: http://localhost:8080
SITE_URL=
PUBLIC_SITE_URL=http://localhost:8080

# Avisos de pedido. Solo servidor. Resend: https://resend.com
# ORDER_FROM_EMAIL tiene que ser un remitente verificado. Sin dominio propio, Resend solo prueba con su correo de onboarding y no llega a clientes.
# ORDER_NOTIFY_EMAIL es el correo de la tienda. Ahí llega cada pedido.
RESEND_API_KEY=
ORDER_FROM_EMAIL=
ORDER_NOTIFY_EMAIL=
GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# === Supabase (solo legacy / migración; dejar vacío si usas Firebase) ===
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_SIGNUP_CODE=
